generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// 1. TENANT (COMPANY)
// ------------------------------------------------------
model Company {
  id            String         @id @default(uuid())
  name          String
  status        String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  users         User[]
  equipment     Equipment[]
  subscriptions Subscription[]
  fuelLogs      FuelLog[]
}

// ------------------------------------------------------
// 2. USERS & RBAC
// ------------------------------------------------------
enum Role {
  SUPER_ADMIN
  COMPANY_OWNER
  FLEET_MANAGER
  SITE_SUPERVISOR
}

model User {
  id        String   @id @default(uuid())
  companyId String?  // Nullable ONLY for Super Admins
  company   Company? @relation(fields: [companyId], references: [id])
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(SITE_SUPERVISOR)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 3. CORE ASSETS (EQUIPMENT)
// ------------------------------------------------------
model Equipment {
  id               String   @id @default(uuid())
  companyId        String   // STRICT ISOLATION
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  category         String   // e.g., "Dredger", "Excavator"
  serialNumber     String?  @unique
  status           String   @default("WORKING") // WORKING, IDLE, MAINTENANCE, BROKEN_DOWN
  deviceImei       String?  @unique // For Teltonika/Ruptela GPS tracking
  fuelCapacity     Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // relations
  telematics      GpsTelematics[]
  fuelLogs        FuelLog[]
  productionLogs  ProductionLog[]
  materialTrips   MaterialTrip[]
}

// -----------------------------------------------------
// 4. TELEMATICS
// ----------------------------------------------------
model GpsTelematics {
  id               BigInt    @id @default(autoincrement())
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id])
  latitude         Decimal   @db.Decimal(10, 6)
  longitude        Decimal   @db.Decimal(10, 6)
  speed            Decimal?  @default(0) @db.Decimal(10, 2)
  engineStatus     Boolean   @default(false)
  fuelLevelPercent Decimal?  @db.Decimal(5, 2)
  receivedAt       DateTime  @default(now())
}

// ------------------------------------------------------
// 5. BILLING & SUBSCRIPTIONS
// ------------------------------------------------------
model SubscriptionPlan {
  id                String         @id @default(uuid())
  name              String
  priceNgn          Decimal        @db.Decimal(12, 2)
  maxEquipmentLimit Int
  subscriptions     Subscription[]
}

model Subscription {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  status             String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  gatewayCustomerId  String?          // Paystack Token
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
}

// -----------------------------------------------------------
// 6. FUEL LOGGING
// -----------------------------------------------------------
model FuelLog {
  id              String    @id   @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  logType         String    // REFUEL, DISPENSE, THEFY_ALERT
  quantityLiters  Decimal   @db.Decimal(10, 2)
  costPerLiter    Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------
// 7. PRODUCTION LOGGING
// --------------------------------------------------------
model ProductionLog {
  id                    String     @id @default(uuid())
  equipmentId           String     // The Dredger
  equipment             Equipment   @relation(fields: [equipmentId], references: [id])
  volumeM3              Decimal     @db.Decimal(10, 2)
  avgPumpPressureBar    Decimal?    @db.Decimal(5, 2)
  operatingHours        Decimal     @db.Decimal(5, 2)
  createdAt             DateTime    @default(now())
}

// ---------------------------------------------------------------
// 8. MATERIAL TRIP LOGGING
// ---------------------------------------------------------------
model MaterialTrip {
  id                    String      @id @default(uuid())
  equipmentId           String      // The Truck or Barge
  equipment             Equipment   @relation(fields: [equipmentId], references: [id])
  ticketNumber          String
  estimatedVolumeM3     Decimal     @db.Decimal(10, 2)
  createdAt             DateTime    @default(now())
}