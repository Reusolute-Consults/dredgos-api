generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// 1. TENANT (COMPANY)
// ------------------------------------------------------
model Company {
  id            String         @id @default(uuid())
  name          String
  status        String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  users         User[]
  equipment     Equipment[]
  subscriptions Subscription[]
}

// ------------------------------------------------------
// 2. USERS & RBAC
// ------------------------------------------------------
enum Role {
  SUPER_ADMIN
  COMPANY_OWNER
  FLEET_MANAGER
  SITE_SUPERVISOR
}

model User {
  id        String   @id @default(uuid())
  companyId String?  // Nullable ONLY for Super Admins
  company   Company? @relation(fields: [companyId], references: [id])
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(SITE_SUPERVISOR)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 3. CORE ASSETS (EQUIPMENT)
// ------------------------------------------------------
model Equipment {
  id               String   @id @default(uuid())
  companyId        String   // STRICT ISOLATION
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  category         String   // e.g., "Dredger", "Excavator"
  serialNumber     String?  @unique
  status           String   @default("WORKING") // WORKING, IDLE, MAINTENANCE, BROKEN_DOWN
  deviceImei       String?  @unique // For Teltonika/Ruptela GPS tracking
  fuelCapacity     Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ------------------------------------------------------
// 4. BILLING & SUBSCRIPTIONS
// ------------------------------------------------------
model SubscriptionPlan {
  id                String         @id @default(uuid())
  name              String
  priceNgn          Decimal        @db.Decimal(12, 2)
  maxEquipmentLimit Int
  subscriptions     Subscription[]
}

model Subscription {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  status             String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  gatewayCustomerId  String?          // Paystack Token
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
}